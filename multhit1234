-- MultiHit Toggle Script v2 - Baseado no dano REAL da tool
-- Toggle: Tecla N | Multiplier: 4x do dano original
-- Cole na Command Bar do Roblox Studio

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()

-- =====================
-- CONFIGURAÇÕES
-- =====================
local DAMAGE_MULTIPLIER = 4       -- Multiplica o dano REAL da tool por 4x
local TOGGLE_KEY = Enum.KeyCode.N
local HIT_WINDOW = 0.4            -- Janela de hit após clicar (segundos)
local multiHitEnabled = false
local hitConnections = {}
local alreadyHit = {}             -- Evita acertar o mesmo alvo várias vezes por swing

-- =====================
-- GUI DE STATUS
-- =====================
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "MultiHitGUI"
screenGui.ResetOnSpawn = false
screenGui.Parent = player.PlayerGui

-- Remove GUI antiga se existir
if player.PlayerGui:FindFirstChild("MultiHitGUI") then
    player.PlayerGui:FindFirstChild("MultiHitGUI"):Destroy()
end
screenGui.Parent = player.PlayerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 230, 0, 60)
frame.Position = UDim2.new(0.5, -115, 0, 20)
frame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
frame.BorderSizePixel = 0
frame.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = frame

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(255, 50, 50)
stroke.Thickness = 2
stroke.Parent = frame

local titleLabel = Instance.new("TextLabel")
titleLabel.Size = UDim2.new(1, 0, 0.45, 0)
titleLabel.Position = UDim2.new(0, 0, 0.05, 0)
titleLabel.BackgroundTransparency = 1
titleLabel.Text = "⚔️  MULTI-HIT  x" .. DAMAGE_MULTIPLIER
titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
titleLabel.TextScaled = true
titleLabel.Font = Enum.Font.GothamBold
titleLabel.Parent = frame

local toggleLabel = Instance.new("TextLabel")
toggleLabel.Size = UDim2.new(1, 0, 0.45, 0)
toggleLabel.Position = UDim2.new(0, 0, 0.52, 0)
toggleLabel.BackgroundTransparency = 1
toggleLabel.Text = "● DESATIVADO  [N]"
toggleLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
toggleLabel.TextScaled = true
toggleLabel.Font = Enum.Font.Gotham
toggleLabel.Parent = frame

-- =====================
-- UPDATE GUI
-- =====================
local function updateGUI()
    if multiHitEnabled then
        toggleLabel.Text = "● ATIVADO  [N]"
        toggleLabel.TextColor3 = Color3.fromRGB(80, 255, 120)
        stroke.Color = Color3.fromRGB(80, 255, 120)
    else
        toggleLabel.Text = "● DESATIVADO  [N]"
        toggleLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        stroke.Color = Color3.fromRGB(255, 50, 50)
    end
end

-- =====================
-- PEGA O DANO REAL DA TOOL
-- =====================
local function getToolDamage(tool)
    -- Tenta pegar o dano nos locais mais comuns dos jogos
    local damage = nil

    -- 1. Direto na tool (valor ou atributo)
    if tool:FindFirstChild("Damage") then
        damage = tool.Damage.Value
    elseif tool:GetAttribute("Damage") then
        damage = tool:GetAttribute("Damage")
    end

    -- 2. Dentro de um ModuleScript/LocalScript de configuração
    if not damage then
        for _, child in pairs(tool:GetDescendants()) do
            if child.Name == "Damage" and (child:IsA("NumberValue") or child:IsA("IntValue")) then
                damage = child.Value
                break
            end
        end
    end

    -- 3. Fallback: dano padrão caso não encontre
    if not damage or damage <= 0 then
        damage = 25
        print("[MultiHit] ⚠️ Dano da tool não encontrado, usando fallback: " .. damage)
    else
        print("[MultiHit] ✅ Dano da tool detectado: " .. damage)
    end

    return damage
end

-- =====================
-- LÓGICA DE HIT (só durante swing)
-- =====================
local function openHitWindow(tool)
    if not multiHitEnabled then return end

    -- Limpa hits anteriores do swing
    alreadyHit = {}

    -- Desconecta hits velhos
    for _, conn in pairs(hitConnections) do
        conn:Disconnect()
    end
    hitConnections = {}

    local baseDamage = getToolDamage(tool)
    local finalDamage = baseDamage * DAMAGE_MULTIPLIER

    print(string.format("[MultiHit] 🗡️ Swing! Dano base: %d | Final: %d (x%d)", baseDamage, finalDamage, DAMAGE_MULTIPLIER))

    -- Conecta .Touched apenas na HANDLE da tool (não no personagem inteiro)
    for _, part in pairs(tool:GetDescendants()) do
        if part:IsA("BasePart") then
            local conn = part.Touched:Connect(function(hit)
                local targetChar = hit:FindFirstAncestorWhichIsA("Model")
                if not targetChar or targetChar == character then return end
                if alreadyHit[targetChar] then return end -- sem multi-hit no mesmo swing

                local targetHumanoid = targetChar:FindFirstChildOfClass("Humanoid")
                if not targetHumanoid or targetHumanoid.Health <= 0 then return end

                alreadyHit[targetChar] = true
                targetHumanoid:TakeDamage(finalDamage)
                print(string.format("[MultiHit] 💥 Acertou: %s | -%d HP", targetChar.Name, finalDamage))
            end)
            table.insert(hitConnections, conn)
        end
    end

    -- Fecha a janela de hit após o tempo configurado
    task.delay(HIT_WINDOW, function()
        for _, conn in pairs(hitConnections) do
            conn:Disconnect()
        end
        hitConnections = {}
        alreadyHit = {}
    end)
end

-- =====================
-- MONITORA A TOOL EQUIPADA
-- =====================
local toolActivatedConn = nil

local function watchTool(tool)
    if toolActivatedConn then
        toolActivatedConn:Disconnect()
    end

    if not tool then return end

    toolActivatedConn = tool.Activated:Connect(function()
        openHitWindow(tool)
    end)

    print("[MultiHit] 🔧 Tool detectada: " .. tool.Name)
end

-- Observa quando equipa/desequipa tool
character.ChildAdded:Connect(function(child)
    if child:IsA("Tool") then
        watchTool(child)
    end
end)

character.ChildRemoved:Connect(function(child)
    if child:IsA("Tool") then
        if toolActivatedConn then
            toolActivatedConn:Disconnect()
        end
        for _, conn in pairs(hitConnections) do
            conn:Disconnect()
        end
        hitConnections = {}
    end
end)

-- Checa se já tem tool equipada agora
for _, child in pairs(character:GetChildren()) do
    if child:IsA("Tool") then
        watchTool(child)
    end
end

-- =====================
-- TOGGLE (TECLA N)
-- =====================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if input.KeyCode == TOGGLE_KEY then
        multiHitEnabled = not multiHitEnabled
        updateGUI()

        if multiHitEnabled then
            print("[MultiHit] ✅ ATIVADO - Clique para atacar com x" .. DAMAGE_MULTIPLIER)
        else
            -- Limpa tudo ao desativar
            for _, conn in pairs(hitConnections) do conn:Disconnect() end
            hitConnections = {}
            alreadyHit = {}
            print("[MultiHit] ❌ DESATIVADO")
        end
    end
end)

-- =====================
-- RECONECTA AO RESPAWN
-- =====================
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    task.wait(1)
    for _, child in pairs(newChar:GetChildren()) do
        if child:IsA("Tool") then watchTool(child) end
    end
    newChar.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then watchTool(child) end
    end)
end)

