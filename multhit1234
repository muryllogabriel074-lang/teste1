print("━━━━━━━━━━━━━━━━━━━━━━━━━")
print(" MultiHit Script Carregado")
print(" Pressione [N] para ativar")
print(" Equipe a tool e CLIQUE para atacar")
print("━━━━━━━━━━━━━━━━━━━━━━━━━")
updateGUI()
