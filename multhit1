-- Lista de métodos REAIS
local metodosReais = {
    {nome = "Mouse1Click", func = clickReal1},
    {nome = "Mouse1Press/Release", func = clickReal2},
    {nome = "Button1 Events", func = clickReal3},
    {nome = "Input Simulation", func = clickReal4}
}

-- Loop principal
local function iniciarAutoClick()
    task.spawn(function()
        local tempoInicial = tick()
        local clicksNoPeriodo = 0
        local metodoFuncional = 1
        
        while autoClickAtivo do
            local clickExecutado = false
            
            -- Tenta cada método até funcionar
            for i, metodo in ipairs(metodosReais) do
                if autoClickAtivo then
                    local sucesso = pcall(metodo.func)
                    if sucesso then
                        clickExecutado = true
                        metodoFuncional = i
                        break
                    end
                end
            end
            
            if clickExecutado then
                totalClicks = totalClicks + 1
                clicksNoPeriodo = clicksNoPeriodo + 1
            end
            
            -- Estatísticas a cada segundo
            if tick() - tempoInicial >= 1 then
                print(string.format("[CLICK] 📊 %d clicks/s - Total: %d (método: %s)", 
                    clicksNoPeriodo, 
                    totalClicks, 
                    metodosReais[metodoFuncional].nome
                ))
                
                texto.Text = string.format("🟢 %d clicks/s", clicksNoPeriodo)
                
                clicksNoPeriodo = 0
                tempoInicial = tick()
            end
            
            -- Controle de velocidade
            task.wait(INTERVALO)
        end
    end)
end

-- Iniciar quando ativar
local toggleOriginal = toggle
toggle = function()
    toggleOriginal()
    if autoClickAtivo then
        iniciarAutoClick()
    end
end

