-- FUNÇÃO DE RE-ENCOSITE INSTANTÂNEO (SEM CLICK NA TELA)
local function reencosteInstantaneo(ferramenta, alvo, quantidade)
    local handle = ferramenta:FindFirstChild("Handle")
    if not handle then return 0 end
    
    local hitsAplicadosAgora = 0
    local posOriginal = handle.Position
    
    -- Loop INSTANTÂNEO (sem task.wait)
    for i = 1, quantidade do
        -- Verificar se alvo morreu
        if alvoAtual and alvoAtual.Health <= 0 then
            break
        end
        
        -- Mover PARA DENTRO do alvo (contato físico)
        handle.CFrame = alvo.HumanoidRootPart.CFrame * CFrame.new(
            math.random(-3, 3)/10,  -- Variação mínima X
            math.random(-3, 3)/10,  -- Variação mínima Y
            -1.3  -- Distância de contato
        )
        
        -- Mover levemente para GERAR NOVO CONTATO (instantâneo)
        handle.CFrame = alvo.HumanoidRootPart.CFrame * CFrame.new(
            math.random(-3, 3)/10,
            math.random(-3, 3)/10,
            -1.5
        )
        
        hitsAplicadosAgora = hitsAplicadosAgora + 1
        
        -- Feedback a cada 100k (usando contador)
        if hitsAplicadosAgora % 100000 == 0 then
            progresso.Text = string.format("%d/1.000.000 re-encostes", 
                hitsAplicados + hitsAplicadosAgora)
        end
        
        -- Forçar execução imediata (sem espera)
        runService.Heartbeat:Wait()  -- Mínimo possível
    end
    
    return hitsAplicadosAgora
end

-- FUNÇÃO PRINCIPAL - 1 MILHÃO DE RE-ENCOSTES INSTANTÂNEOS
local function executar1MilhaoReencoste(ferramenta, inimigo)
    if not ativo then return end
    
    local humanoide = inimigo:FindFirstChildWhichIsA("Humanoid")
    if not humanoide then return end
    
    alvoAtual = humanoide
    hitsAplicados = 0
    local tempoInicial = tick()
    local loteAtual = 1
    
    print("\n[INSTANT] 🎯 ATACANDO: " .. tostring(inimigo.Name))
    print("[INSTANT] ❤️ Vida inicial: " .. math.floor(humanoide.Health))
    print("[INSTANT] ⚡ Aplicando 1 MILHÃO de re-encostes INSTANTÂNEOS...")
    
    -- Dividir em lotes para não travar o jogo
    local LOTE = 10000  -- 10k re-encostes por lote
    
    while ativo and humanoide.Health > 0 and hitsAplicados < MULTIPLICADOR do
        -- Calcular quanto falta
        local restante = MULTIPLICADOR - hitsAplicados
        local tamanhoLote = math.min(LOTE, restante)
        
        -- Aplicar lote INSTANTÂNEO
        local hitsNoLote = reencosteInstantaneo(ferramenta, inimigo, tamanhoLote)
        hitsAplicados = hitsAplicados + hitsNoLote
        
        -- Estatísticas a cada lote
        local tempoPassado = tick() - tempoInicial
        local hitsPorSegundo = math.floor(hitsAplicados / tempoPassado)
        local percentual = (hitsAplicados / MULTIPLICADOR) * 100
        
        print(string.format("[INSTANT] 📊 Lote %d: %d/1.000.000 (%.1f%%) - %d hits/s - Vida: %.1f", 
            loteAtual, hitsAplicados, percentual, hitsPorSegundo, humanoide.Health))
        
        loteAtual = loteAtual + 1
        
        -- Se morreu, para
        if humanoide.Health <= 0 then
            print("\n[INSTANT] ✅ ALVO MORTO!")
            print("[INSTANT] 📊 Re-encostes aplicados: " .. hitsAplicados .. "/1.000.000")
            print("[INSTANT] ⏱️ Tempo total: " .. (tick() - tempoInicial) .. "s")
            print("[INSTANT] ⚡ Média: " .. math.floor(hitsAplicados / (tick() - tempoInicial)) .. " re-encostes/s")
            break
        end
        
        -- Pequena pausa entre lotes para não crashar
        task.wait(0.001)
    end
    
    -- Se completou 1 milhão mas não morreu
    if humanoide.Health > 0 and hitsAplicados >= MULTIPLICADOR then
        print("\n[INSTANT] ⚠️ 1 MILHÃO de re-encostes aplicados!")
        print("[INSTANT] ❤️ Vida restante: " .. math.floor(humanoide.Health))
        
        -- Continuar até morrer (agora sem limite)
        print("[INSTANT] 🔄 Continuando até morrer...")
        
        while ativo and humanoide.Health > 0 do
            reencosteInstantaneo(ferramenta, inimigo, 10000)
            hitsAplicados = hitsAplicados + 10000
            
            if hitsAplicados % 100000 == 0 then
                print(string.format("[INSTANT] 📊 %d re-encostes totais - Vida: %.1f", 
                    hitsAplicados, humanoide.Health))
            end
            
            task.wait(0.001)
        end
        
        print("[INSTANT] ✅ Alvo morto após " .. hitsAplicados .. " re-encostes!")
    end
    
    progresso.Text = "0/1.000.000 re-encostes"
    alvoAtual = nil
end

-- DETECTOR DE DASH
local dashDetectado = false
local dashTimer = 0

local function detectarDash()
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        local humanoid = player.Character.Humanoid
        local velocidade = humanoid.MoveDirection.Magnitude * humanoid.WalkSpeed
        
        if velocidade > humanoid.WalkSpeed * 1.8 then
            dashDetectado = true
            dashTimer = tick()
            return true
        end
    end
    
    if dashDetectado and tick() - dashTimer > 0.5 then
        dashDetectado = false
    end
    
    return dashDetectado
end

-- HOOKAR TOUCHED (detectar contato inicial)
local function hookarTouched(parte, ferramenta)
    if not parte then return end
    
    parte.Touched:Connect(function(hit)
        if not ativo then return end
        if dashDetectado then return end
        if not hit or not hit.Parent then return end
        
        -- Ignorar próprio jogador
        if hit.Parent == player.Character or hit.Parent:IsDescendantOf(player.Character) then
            return
        end
        
        -- Verificar se é inimigo
        local humanoide = hit.Parent:FindFirstChildWhichIsA("Humanoid")
        if not humanoide and hit.Parent.Parent then
            humanoide = hit.Parent.Parent:FindFirstChildWhichIsA("Humanoid")
        end
        
        if humanoide and humanoide.Health > 0 and not processandoAtaque then
            processandoAtaque = true
            
            local modeloInimigo = hit.Parent
            if not modeloInimigo:FindFirstChild("HumanoidRootPart") then
                modeloInimigo = hit.Parent.Parent
            end
            
            print("[INSTANT] 🎯 CONTATO INICIAL DETECTADO!")
            
            -- Executar 1 MILHÃO de re-encostes INSTANTÂNEOS
            task.spawn(function()
                executar1MilhaoReencoste(ferramenta, modeloInimigo)
                processandoAtaque = false
            end)
        end
    end)
end

-- Processar ferramentas
local function processarFerramenta(tool)
    if not tool:IsA("Tool") then return end
    
    local handle = tool:FindFirstChild("Handle")
    if handle then
        hookarTouched(handle, tool)
        print("[INSTANT] 🔗 Ferramenta hookada:", tool.Name)
    end
end

-- Conectar tudo
local function conectarTudo()
    if player.Character then
        for _, tool in ipairs(player.Character:GetChildren()) do
            if tool:IsA("Tool") then
                task.wait(0.1)
                processarFerramenta(tool)
            end
        end
        
        player.Character.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then
                task.wait(0.1)
                processarFerramenta(child)
            end
        end)
    end
    
    player.CharacterAdded:Connect(function(char)
        task.wait(1)
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                task.wait(0.1)
                processarFerramenta(tool)
            end
        end
        
        char.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then
                task.wait(0.1)
                processarFerramenta(child)
            end
        end)
    end)
end

-- Detector de dash
runService.Heartbeat:Connect(function()
