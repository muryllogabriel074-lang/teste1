-- Lista de nomes de espadas (pode adicionar mais)
local nomesEspadas = {
    "Sword", "Katana", "Saber", "Blade", "Espada", 
    "Cutlass", "Scimitar", "Rapier", "Claymore", "Longsword",
    "Dagger", "Knife", "Faca", "Espadinha", "Weapon"
}

-- Função para verificar se é espada
function isEspada(tool)
    if not soEspadas then return true end
    
    local nome = tool.Name:lower()
    for _, espada in ipairs(nomesEspadas) do
        if nome:find(espada:lower()) then
            return true
        end
    end
    
    -- Verificar pelo formato/handle
    local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("Part")
    if handle then
        -- Espadas geralmente tem handle alongado
        if handle.Size.Y > handle.Size.X * 1.5 and handle.Size.Y > handle.Size.Z * 1.5 then
            return true
        end
    end
    
    return false
end

-- Função para validar quantidade
function validarQuantidade(valor)
    local num = tonumber(valor)
    if num and num > 0 then
        -- Limitar entre 1 e 500 para evitar problemas
        if num > 500 then
            return 500
        elseif num < 1 then
            return 1
        else
            return math.floor(num) -- Número inteiro
        end
    else
        return 50 -- Valor padrão
    end
end

-- Função para piscar hitbox (quantidade ajustável)
function piscarHitbox(handle)
    if not handle or not ativo then return end
    
    piscando = true
    tamanhoOriginal = handle.Size
    
    -- Calcular tempo entre piscadas para 100x por segundo
    -- Se queremos 100 piscadas/segundo, cada ciclo leva 0.01 segundos
    -- Mas como temos 2 mudanças por ciclo (sumir/aparecer), cada espera é 0.005 segundos
    local tempoEspera = 0.005 -- 5ms (200 frames por segundo aproximado)
    
    -- Piscar quantidade vezes (cada ciclo = sumir + aparecer)
    for i = 1, quantidadePiscadas do
        if not ativo or not handle or not handle.Parent then 
            piscando = false
            return 
        end
        
        -- Sumir (tamanho 0.01)
        handle.Size = Vector3.new(0.01, 0.01, 0.01)
        RunService.Heartbeat:Wait() -- Espera 1 frame (~0.005-0.016 segundos)
        
        -- Aparecer 100x maior
        if not ativo or not handle or not handle.Parent then 
            piscando = false
            return 
        end
        handle.Size = tamanhoOriginal * 100
        RunService.Heartbeat:Wait() -- Espera 1 frame
    end
    
    -- Restaurar tamanho original
    if handle and handle.Parent then
        handle.Size = tamanhoOriginal
    end
    
    piscando = false
end

-- Detectar clique do mouse
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if not ativo then return end
    if piscando then return end
    
